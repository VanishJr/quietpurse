# Backend address as seen BY THE BROWSER. In dev you usually DON'T need this:
# vite.config.ts proxies /api, so the app talks to its own origin — which also
# means it works from a phone on the same Wi-Fi with no extra setup.
# Set it for a production build served without such a proxy.
# VITE_API_URL=http://192.168.0.10:4000

# Backend address as seen BY THE VITE DEV SERVER (proxy target only, never
# shipped to the client). Defaults to http://localhost:4000.
# BACKEND_URL=http://localhost:4000

# Same secret as API_KEY in backend/.env — sent in the x-api-key header.
# NOTE: this is baked into the client bundle in plain text. Never point a public
# deployment at a database you care about; use seed-demo data and a separate key.
VITE_API_KEY=
