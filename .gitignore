node_modules/
dist/
# `npm run coverage` prints to the terminal; the html reporter, when asked for, writes here
coverage/

# secrets and local configuration; the examples are the one published form
.env*
!.env.example
backend/secrets/

# per-checkout tool folders and notes, never published: every folder whose name
# starts with a dot, except the one this repository publishes
.*/
!.github/

# personal data: database, backups, bank statements
backend/data/
*.db
*.db-shm
*.db-wal
# a statement in any of the formats the app reads, wherever it is dropped. PDF fixtures
# are built in code (backend/test/pdffixture.ts), so nothing in the tree needs a rule
# negated; a redacted one that ever does takes a !line.
*.csv
*.xlsx
*.pdf
# the app's own database and lock, for a relative QUIETPURSE_HOME. It resolves from backend/,
# where npm runs the server, so the database lands in backend/ or a folder directly inside
# it; the source directory of the same name is the exception. Stored statements need no
# rule of their own: each one carries the extension of a format above.
/backend/db/
/backend/*/db/
!/backend/src/db/
quietpurse.lock*

*.log
.DS_Store
