node_modules/
dist/
# `npm run coverage` prints to the terminal; the html reporter, when asked for, writes here
coverage/

# secrets and local configuration
.env
.env.local
.env.*.local
backend/secrets/

# personal notes and internal planning, not part of the project
Report.md
Strategy.md
ROADMAP.md
DEBT.md
SETTINGS_REDESIGN_PLAN.md
docs/
# what the auth redesign needs from a server that cannot do it yet, and the decisions
# taken while drawing it. A working note on the same footing as the plan above: the
# comments in AuthScreen.tsx and auth.css cite it by section, and it is deliberately
# not travelling with them.
REDESIGN-BACK-DEBT.md

# agent pipeline. The mechanism is published - how a task is run, the agent definitions,
# the commands and the concepts they share - and the material a task produces is not:
# briefs and memos outweigh the source, and a request is the owner's words about their
# own data. Listed rather than un-ignored wholesale, so that a future
# .claude/settings.local.json is excluded by default instead of by remembering to.
.claude/*
!.claude/agents/
!.claude/commands/
.agents/*
!.agents/README.md
!.agents/concepts/
# CLAUDE.md carries the half that rots - test counts, what a green run covered on which
# tip. AGENTS.md carries the durable half and is published.
CLAUDE.md
# the spec tool's working files: the task-specs it writes under context/ and whatever else
# it keeps per checkout. It seeds a nested .gitignore there, which specs.test.ts's walk
# never reads; this root line is what keeps that walk out.
.thinkrail/

# personal data: database, backups, bank statements
backend/data/
*.db
*.db-shm
*.db-wal
*.csv
# a statement dropped anywhere but backend/data/ was committable until row 6c added
# this. PDF fixtures are built in code (backend/test/pdffixture.ts), so nothing in
# the tree needs the rule negated; a redacted one that ever does takes a !line.
*.pdf

*.log
.DS_Store
