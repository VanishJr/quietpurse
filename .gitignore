node_modules/
dist/
# `npm run coverage` prints to the terminal; the html reporter, when asked for, writes here
coverage/

# secrets and local configuration; the examples are the one published form
.env*
!.env.example
backend/secrets/

# personal notes and internal planning, not part of the project
Report.md
Strategy.md
ROADMAP.md
DEBT.md
SETTINGS_REDESIGN_PLAN.md
docs/
# what the auth redesign needs from a server that cannot do it yet, and the decisions
# taken while drawing it: a working note on the same footing as the plan above.
REDESIGN-BACK-DEBT.md

# a contributor's own AI-assistant setup and working notes. Whole directories, not a list:
# a task's notes are the owner's words about their own data. AGENTS.md is the published
# half and stays tracked.
.claude/
.agents/
CLAUDE.md
# the spec tool's working files: the task-specs it writes under context/ and whatever else
# it keeps per checkout. It seeds a nested .gitignore there, which specs.test.ts's walk
# never reads; this root line is what keeps that walk out.
.thinkrail/

# personal data: database, backups, bank statements
backend/data/
*.db
*.db-shm
*.db-wal
# a statement in any of the formats the app reads, wherever it is dropped. PDF fixtures
# are built in code (backend/test/pdffixture.ts), so nothing in the tree needs a rule
# negated; a redacted one that ever does takes a !line.
*.csv
*.xlsx
*.pdf
# the app's own database and lock, for a relative QUIETPURSE_HOME. It resolves from backend/,
# where npm runs the server, so the database lands in backend/ or a folder directly inside
# it; the source directory of the same name is the exception. Stored statements need no
# rule of their own: each one carries the extension of a format above.
/backend/db/
/backend/*/db/
!/backend/src/db/
quietpurse.lock*

*.log
.DS_Store
