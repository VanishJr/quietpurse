# HTTP API port (the server listens on 0.0.0.0, i.e. reachable from a phone over Wi-Fi)
PORT=4000

# --- Auth (better-auth) ---
# Key that session cookies are signed with. MUST be set to a random value on any
# real deployment (generate one with: openssl rand -base64 32).
BETTER_AUTH_SECRET=

# The backend's own address as browsers see it. Defaults to http://localhost:PORT.
# BETTER_AUTH_URL=http://localhost:4000

# Origins allowed to call the API with session cookies, comma-separated. Only needed
# when the web client is served from a DIFFERENT origin than the backend; with a
# same-origin proxy in front (the Vite dev server, or your production static host
# proxying /api) leave it alone. Defaults to the Vite dev server.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Registration gate. Empty = anyone who can reach the server can create an account,
# which is fine on a laptop and not fine on a public host. Set any string and
# sign-up requires it (the web form asks for it automatically).
# SIGNUP_INVITE_CODE=

# Password of the postgres service in docker-compose. Read by BOTH the database and
# the backend's DATABASE_URL, so change it in one place. The compose default
# ("finto") is a dev convenience: under NODE_ENV=production the backend refuses to
# start on it, same as it refuses to start on an unset BETTER_AUTH_SECRET.
# Note: compose reads this from the .env next to docker-compose.yml (repo root),
# not from this file.
# POSTGRES_PASSWORD=

# --- Monobank ---
# Personal token: https://api.monobank.ua/ -> the "Get token" button (QR code in the mono app)
MONOBANK_TOKEN=

# From which date to keep history (YYYY-MM-DD). Defaults to a year ago.
# Move the date further back and the next sync backfills the missing chunk by itself.
SYNC_START=

# A separate history depth for Monobank (YYYY-MM-DD). Defaults to six months ago.
# The reason is rate limits: Monobank returns at most 31 days per request and allows
# 1 request/60 s, so a year of history across four accounts takes roughly 47 minutes
# to walk — six months, half that. Enable Banking has no such limit, so depth is free
# there and Revolut/N26 keep fetching from SYNC_START.
# If SYNC_START is set and this one is empty, Monobank uses SYNC_START.
MONOBANK_SYNC_START=

# Account owner names, comma-separated, as they appear in statements
OWNER_NAMES=

# Names of family members whose help is income but NOT your own earnings
FAMILY_NAMES=

# Base currency of all totals (average spending, independence threshold, budgets).
# Every amount is converted at the rate on the transaction's date. Defaults to EUR.
BASE_CURRENCY=EUR

# Auto-sync every N minutes (0 = off). Defaults to 360 (6 hours).
SYNC_INTERVAL_MIN=360

# --- Enable Banking (Revolut, N26 and others) ---
# Application ID from https://enablebanking.com/cp/ (an app in Restricted Production)
EB_APP_ID=
# Path to the private RSA key (PEM) downloaded when the app was created in the
# Control Panel. A relative path is resolved from the backend/ directory.
EB_PRIVATE_KEY_PATH=./secrets/enablebanking.pem
# Redirect URL — MUST be added to the app's settings in the Control Panel.
# IMPORTANT: the Control Panel only accepts https, and rejects http://localhost
# ("uses unsupported scheme"). Work around it with a static bridge page on any https
# host (GitHub Pages, say): Enable Banking redirects the browser to it with
# ?code=&state=, and a little JS forwards it to
# http://localhost:4000/api/enablebanking/callback. The backend never needs to be
# exposed to the internet.
REDIRECT_URL=https://<username>.github.io/legal/callback.html

# PostgreSQL connection string. The default matches the postgres service in
# docker-compose.yml (docker compose up -d postgres for local development).
# DATABASE_URL=postgres://finto:finto@localhost:5432/finto

# --- Source documents (the uploaded statements themselves) ---
# Key every stored statement is sealed with (AES-256-GCM). Any string of any length
# works — generate one with: openssl rand -base64 32. MUST be set on any real
# deployment: under NODE_ENV=production the backend refuses to start on the public
# dev fallback, the same way it refuses an unset BETTER_AUTH_SECRET. Lose it or
# change it and every document already stored becomes unreadable — there is no way
# to hold the old key and the new one at once.
DOCUMENT_ENCRYPTION_KEY=

# Where those documents are kept. A relative path is resolved from the backend/
# directory. The default is also where docker-compose mounts the `documents` volume,
# so under Docker leave it alone — and outside Docker make sure the directory is on
# storage that gets backed up: an uploaded statement is the one artefact the app
# cannot reconstruct.
# DOCUMENT_STORE_PATH=./data/documents
