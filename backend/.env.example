# Nothing here is required. `npm start` from the repository root works with no .env at
# all: the database and the uploaded statements go under ~/Quietpurse, and the app listens
# on http://localhost:4000 for this machine only. A PORT, BASE_CURRENCY or FX_PROVIDER the
# app cannot read stops the start with a sentence saying what to write instead; an empty one
# takes the default.

# The port the app is served on.
# PORT=4000

# Where everything Quietpurse keeps lives: the database in db/, the uploaded statements in
# statements/. Defaults to a Quietpurse folder in your home directory.
# QUIETPURSE_HOME=/home/you/Quietpurse

# Listen on every network interface instead of this machine only - for opening the
# app from a phone on the same Wi-Fi. There is no sign-in, so everyone who can reach
# the port can read and change your data; leave this unset unless you mean that.
# QUIETPURSE_HOST=0.0.0.0

# Account owner names, comma-separated, as they appear in statements. Seeds the
# setting the app edits on its Settings screen; after the first start, edit it there.
OWNER_NAMES=

# Names of family members whose help is income but NOT your own earnings.
FAMILY_NAMES=

# Base currency of all totals (average spending, independence threshold, budgets).
# Every amount is converted at the rate on the transaction's date. Defaults to EUR.
BASE_CURRENCY=EUR

# Where exchange rates come from: auto asks the European Central Bank and then the National
# Bank of Ukraine; ecb or nbu asks that one only.
# FX_PROVIDER=auto

# Use a PostgreSQL server instead of the embedded database under QUIETPURSE_HOME. Optional;
# the schema is created on the first start either way.
# DATABASE_URL=postgres://quietpurse:quietpurse@localhost:5432/quietpurse

# Keep the uploaded statements somewhere other than QUIETPURSE_HOME/statements. A relative
# path is resolved from the backend/ directory.
# DOCUMENT_STORE_PATH=/home/you/Quietpurse/statements
