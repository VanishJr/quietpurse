{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  // Everything except the test tree, which tsconfig.test.json takes as ESM. No
  // "include": a directory added later is covered without anybody remembering,
  // which is the hole this file had. `npm run typecheck` runs both configs -
  // bare `tsc --noEmit` reads this one alone and never sees test/.
  "exclude": ["node_modules", "test"]
}
